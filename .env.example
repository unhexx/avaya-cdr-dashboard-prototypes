# Copy to .env and fill locally. Never commit .env.
# Placeholders only: no real hostnames, credentials, or customer numbers.

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=change-me-in-local-env
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=

# --- Canonical store (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://avaya:avaya@localhost:5432/avaya_cdr
POSTGRES_USER=avaya
POSTGRES_PASSWORD=avaya
POSTGRES_DB=avaya_cdr
POSTGRES_PORT=5432

# --- Recordings sql-source (MariaDB or PostgreSQL, read-only) ---
# Leave empty to use fixtures only.
RECORDINGS_SQL_URL=
# Example MariaDB (Avaya Contact Recorder / VMPro sidecar):
# RECORDINGS_SQL_URL=mysql+aiomysql://reader:reader@localhost:3306/acr
# Example PostgreSQL:
# RECORDINGS_SQL_URL=postgresql+asyncpg://reader:reader@localhost:5432/recordings
RECORDINGS_SQL_DIALECT=auto
RECORDINGS_MEDIA_ROOT=
# IPO >= R11.1 encrypted media: never decrypt; API returns 409 + metadata.
RECORDINGS_ALLOW_ENCRYPTED_AUDIO=false

# --- Redis (optional cache) ---
REDIS_URL=

# --- Avaya Communication Manager ---
# SAT over SSH, read-only command allowlist. Empty = mock connector.
CM_SAT_HOST=
CM_SAT_PORT=5022
CM_SAT_USER=
CM_SAT_PASSWORD=
CM_SAT_TIMEOUT_SECONDS=15
# CDR printer-port over TCP (CM "IP CDR"). Empty = fixture ingest.
CM_CDR_LISTEN_HOST=0.0.0.0
CM_CDR_LISTEN_PORT=9000
CM_CDR_FORMAT=expanded
CM_SNMP_HOST=
CM_SNMP_COMMUNITY=
CM_SNMP_VERSION=2c

# --- Avaya IP Office ---
# SMDR TCP (default 8888). Empty = fixture ingest.
IPO_SMDR_HOST=
IPO_SMDR_PORT=8888
IPO_SNMP_HOST=
IPO_SNMP_COMMUNITY=
# SSA HTTPS read-only. Never SysMonitor protocol.
IPO_SSA_URL=
IPO_SSA_USER=
IPO_SSA_PASSWORD=

# --- Session Manager / SBCE syslog ---
SYSLOG_LISTEN_HOST=0.0.0.0
SYSLOG_LISTEN_PORT=5514
SYSLOG_PROTOCOL=udp

# --- Feature flags ---
USE_FIXTURES=true
ENABLE_LIVE_CONNECTORS=false
ENABLE_RECORDING_AUDIO=true
